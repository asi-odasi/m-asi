# ==== Gemini (LLM / Embedding) ====
GEMINI_API_KEY=

# ==== Kaggle ====
# kaggle.com/settings > API > Create New Token ile alınır
KAGGLE_USERNAME=
KAGGLE_KEY=

# ==== PostgreSQL ====
# DATABASE_URL doluysa DB_* alanlarının önüne geçer (Railway'de Postgres eklentisinin
# DATABASE_URL değişkenini doğrudan referans vermek için kullanılır).
DATABASE_URL=
DB_SERVER=localhost
DB_PORT=5432
DB_NAME=masi
DB_USER=postgres
DB_PASSWORD=
